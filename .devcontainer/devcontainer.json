// Dev container for SplitIQ — the "desktop box".
//
// WHAT THIS IS FOR: one definition of the dev toolchain that VS Code, Cursor,
// Codespaces and Claude Code all use. It can be reached three ways at once, all
// landing in the same container: VS Code ("Reopen in Container", locally or over
// a Remote Tunnel to the machine running Docker), the Claude Code CLI in its
// terminal, and `claude remote-control` started inside it, which puts that
// session on claude.ai/code and the Claude app. Usage: docs/DEV_ENVIRONMENTS.md.
//
// WHAT IT IS NOT: the Anthropic-managed cloud environments (SplitIQ, Full,
// Default) do NOT read this file — they are a setup script on a fixed base image,
// and no editor can attach to them. That is the "cloud box"; the two boxes share
// the toolchain versions and `npm run e2e:docker`, not a definition.
// https://code.claude.com/docs/en/cloud-environments
//
// WHY DOCKER-OUTSIDE-OF-DOCKER: containers started in here run on the HOST's
// Docker (e.g. its Docker Desktop), sharing its image cache — the ~2 GB
// Playwright image is pulled once, not once per container rebuild — and they show
// in Docker Desktop. The cost: a `docker run -v` path is resolved on the host, so
// it must be the host path, which is why LOCAL_WORKSPACE_FOLDER is exported
// below and web/scripts/playwright-docker.mjs uses it.
// https://github.com/devcontainers/features/tree/main/src/docker-outside-of-docker
//
// WHY PLAYWRIGHT IS NOT BAKED IN: a visual baseline is only valid when generated
// in the exact pinned image, and e2e-web.yml reads that tag FROM
// web/package-lock.json so a hardcoded tag cannot rot. Hardcoding it here would
// reintroduce that rot with a worse failure mode: a drifted container still
// produces PNGs, they are just silently wrong. `npm run e2e:docker` reads the
// version from the lockfile exactly as CI does. One source of truth, not two.
//
// WHY NO ANDROID SDK: ci-android.yml builds the APK on a GitHub runner that
// already ships the SDK. Adding it here would cost several GB on every container
// for a job nobody runs locally. `npx cap sync android` stays a CI concern.
//
// OPEN THE MAIN CHECKOUT, NOT A GIT WORKTREE: a worktree's `.git` is a file
// pointing at the main checkout by absolute host path, which is not mounted, so
// git fails inside the container — and so does every check built on
// `git ls-files` (check:migrations among them). The devcontainer CLI's
// --mount-git-worktree-common-dir is meant to fix this, but only for worktrees
// made with `git worktree add --relative-paths` (git >= 2.48); untested here.
{
  "name": "SplitIQ",

  // Node 22 to match `engines: { node: ">=22.19" }` in web/package.json and
  // `node-version: 22` in every CI workflow.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",

  "features": {
    // Edge functions are Deno (ci-functions.yml), and .vscode/settings.json
    // points the Deno language server at supabase/functions only.
    // NOTE: this feature takes a concrete release or "latest"; CI pins v2.x, so
    // "latest" is the one place the two can drift — it will move to Deno 3
    // whenever that ships, while CI stays on 2.x.
    "ghcr.io/devcontainers-extra/features/deno:1": { "version": "latest" },

    // pipeline/squat-anatomy; ci-pipeline.yml pins 3.13.
    "ghcr.io/devcontainers/features/python:1": { "version": "3.13" },

    // Docker CLI wired to the host's daemon — see the header.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},

    // The shipping workflow calls `gh` (`gh pr checks`, `gh api .../rulesets`,
    // opening PRs), and this box has no GitHub MCP connector, so gh is its
    // road to GitHub. "latest" is fine: gh is not a
    // CI-parity tool. The lockfile pins the install script, not the binary.
    "ghcr.io/devcontainers/features/github-cli:1": {},

    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // The host path of this checkout, for `docker run -v` under
  // docker-outside-of-docker.
  "remoteEnv": { "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}" },

  // Keeps the Claude Code login, settings and the Remote Control trust prompt
  // across rebuilds. Without CLAUDE_CONFIG_DIR, ~/.claude.json stays in the home
  // directory and is discarded on rebuild.
  // https://code.claude.com/docs/en/devcontainer#persist-authentication-and-settings-across-rebuilds
  //
  // gh's login gets a volume of its own. ~/.config is not on a volume, so
  // `gh auth login` would be lost on rebuild; with no keyring in a container,
  // gh writes the token as plain text to hosts.yml in GH_CONFIG_DIR. A named
  // volume never leaves Docker, unlike mounting the host's gh config, which the
  // Claude devcontainer page warns against. A direct child of /home/node, so
  // Docker never creates a root-owned ~/.config; separate from the Claude
  // volume, so each login resets alone.
  // https://cli.github.com/manual/gh_auth_login
  // https://cli.github.com/manual/gh_help_environment
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=gh-config-${devcontainerId},target=/home/node/.gh-config,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "GH_CONFIG_DIR": "/home/node/.gh-config"
  },

  // Runs during a Codespaces prebuild, so node_modules is baked into the
  // prebuilt image rather than installed on every start. postCreateCommand
  // would run too late for that. The root install runs husky's `prepare`,
  // which sets core.hooksPath; without it, a clone opened straight into the
  // container skips the pre-commit and pre-push hooks silently.
  "onCreateCommand": "npm ci && cd web && npm ci",

  // Object form: the entries run in parallel, and they are independent.
  // https://containers.dev/implementors/json_reference/#formatting-string-vs-array-properties
  //
  // context7: the Context7-first rule in CLAUDE.md needs the server, and only
  // the cloud box gets it as a connector. User scope lands in the
  // CLAUDE_CONFIG_DIR volume. `mcp add` fails with "already exists" on a
  // rebuild, so `mcp get` guards it (exit 0 for any configured server, 1 for a
  // missing one: observed on CLI 2.1.329, not documented). The name must be
  // `Context7` to match the allow-list in .claude/settings.json. Not a
  // committed .mcp.json: the cloud box would load it beside its own connector.
  // postCreate, not onCreate: onCreate also runs in a Codespaces prebuild,
  // before the user's config volume is theirs. A failed add (offline) warns on
  // stderr rather than failing the container's creation; the next rebuild, or
  // the command in docs/DEV_ENVIRONMENTS.md, adds it.
  //
  // gh-config: a fresh named volume can come up root-owned.
  // https://code.visualstudio.com/remote/advancedcontainers/improve-performance
  "postCreateCommand": {
    "context7": "claude mcp get Context7 >/dev/null 2>&1 || claude mcp add --scope user --transport http Context7 https://mcp.context7.com/mcp || echo 'Context7 not added; see docs/DEV_ENVIRONMENTS.md' >&2",
    "gh-config": "sudo chown node:node /home/node/.gh-config"
  },

  "forwardPorts": [5173, 4173],
  "portsAttributes": {
    "5173": { "label": "vite dev", "onAutoForward": "notify" },
    // playwright.config.js gives its own webServer this port — leave it free.
    "4173": { "label": "vite preview", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      // Mirrors .vscode/extensions.json. The spec keeps these lists separate:
      // that file only *recommends* to a local editor, while these are actually
      // installed into the container.
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "denoland.vscode-deno",
        "usernamehw.errorlens",
        "eamodio.gitlens",
        "github.vscode-pull-request-github"
      ]
    }
  },

  // No hostRequirements: the 2-core Codespaces default builds and tests this
  // repo, and forcing a minimum doubles the per-hour cost. Raise it here if the
  // vitest suite gets slow enough to be worth paying for.
  "remoteUser": "node"
}
