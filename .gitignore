node_modules
dist
.DS_Store
*.local
.vite
.env
coverage
/scripts/
test-results
playwright-report
.playwright
# Lighthouse CI local run output
.lighthouseci/

# design-sync (claude.ai/design) — staged scripts, build output, machine state
web/.ds-sync/
web/ds-bundle/
web/.design-sync/.cache/
web/.design-sync/learnings/
web/.design-sync/node_modules

# Generated by ad-hoc local `deno run`. The edge functions carry no root dep
# manifest — Supabase resolves them at deploy against its own Deno — so a lock
# written by whatever Deno happens to be on a dev machine is noise, not a
# reproducibility guarantee.
deno.lock

# Per-session git worktrees (EnterWorktree). Concurrent Claude Code sessions each
# get their own checkout here, so two sessions cannot race on one working tree.
.claude/worktrees/

# Supabase CLI per-machine state (`supabase link` writes the linked project ref,
# the CLI writes its version check). Machine-local, never read by CI or scripts (#548).
supabase/.temp/

# Voice-cue clips (#785): fetched by web/scripts/fetch-voice-cues.mjs, not committed.
# The slim index next to them is tracked.
web/public/audio/cues/*/
