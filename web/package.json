{
  "name": "splitiq",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "size": "node scripts/check-bundle-size.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "lint": "eslint src/ scripts/ e2e/ eslint.config.js lingui.config.js playwright.config.js vite.config.js",
    "format": "prettier --write src/ scripts/ e2e/ eslint.config.js lingui.config.js playwright.config.js vite.config.js",
    "format:check": "prettier --check src/ scripts/ e2e/ eslint.config.js lingui.config.js playwright.config.js vite.config.js",
    "check:zones": "node scripts/check-zone-bands.mjs",
    "check:design-sync": "node scripts/check-design-sync-entry.mjs",
    "check:colours": "node scripts/check-colour-literals.mjs",
    "check:no-llm": "node scripts/check-no-llm-path.mjs",
    "check:names": "node scripts/check-names.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:hooks": "node scripts/check-hook-wiring.mjs",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui check sync --clean && lingui check missing --mode catalog --locale es",
    "i18n:review": "node scripts/i18n-review-sheet.mjs",
    "prepare": "cd .. && husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.0",
    "@capgo/capacitor-bluetooth-low-energy": "^8.2.9",
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@sentry/react": "^11.12.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "three": "0.187.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "@babel/plugin-transform-runtime": "^7.29.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "6.12.0",
    "@lingui/conf": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@lingui/vite-plugin": "6.12.0",
    "@playwright/test": "^1.65.0",
    "@sentry/vite-plugin": "^11.12.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "espree": "^11.2.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
