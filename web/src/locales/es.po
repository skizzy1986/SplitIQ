msgstr "Registrar una sesión"

#: src/views/ErgView.jsx
msgid "No reading"
msgstr "Sin lectura"

#. Login form field label, all capitals
#: src/AuthGate.jsx
msgid "PASSWORD"
msgstr "CONTRASEÑA"

#. Mobile tab bar
#: src/constants/destinations.js
msgid "Progress"
msgstr "Progreso"

#. Invite form field label, all capitals
#: src/components/InviteSignupForm.jsx
msgid "REPEAT THE PASSWORD"
msgstr "REPITE LA CONTRASEÑA"

#. Login button
#: src/AuthGate.jsx
msgid "SIGN IN"
msgstr "INICIAR SESIÓN"

#: src/AuthGate.jsx
msgid "Sign in to continue"
msgstr "Inicia sesión para continuar"

#. Tooltip on the sign-out button
#. Tooltip on the sign-out button
#: src/AuthGate.jsx
msgid "Sign out"
msgstr "Cerrar sesión"

#. Invite sign-up error for any other cause.
#: src/components/InviteSignupForm.jsx
msgid "Sign-up isn't available right now. Message whoever invited you."
msgstr "El registro no está disponible ahora mismo. Escríbele a quien te invitó."

#. Login button while the request is in flight
#: src/AuthGate.jsx
msgid "SIGNING IN…"
msgstr "INICIANDO SESIÓN…"

#: src/views/StrengthView.jsx
msgid "Strength"
msgstr "Fuerza"

#. Splash word cycle, one discipline, all capitals
#: src/components/SplashScreen.jsx
msgid "STRENGTH"
msgstr "FUERZA"

#. Splash-screen loading caption, all capitals
#: src/components/SplashScreen.jsx
msgid "SYNCING TRAINING LOG"
msgstr "SINCRONIZANDO REGISTRO DE ENTRENAMIENTO"

#. Invite sign-up error. Deliberately says nothing more specific.
#: src/components/InviteSignupForm.jsx
msgid "That code and email did not work. Check them, or ask whoever invited you for a new code."
msgstr "Ese código y ese correo no funcionaron. Revísalos, o pídele un código nuevo a quien te invitó."

#. Login error. Only shown in Spanish; English shows the server message.
#: src/utils/authError.js
msgid "The server took too long to answer. Try again."
msgstr "El servidor tardó demasiado en responder. Inténtalo de nuevo."

#. Invite sign-up error.
#: src/components/InviteSignupForm.jsx
msgid "The two passwords don't match."
msgstr "Las dos contraseñas no coinciden."

#. Login error. Only shown in Spanish; English shows the server message.
#: src/utils/authError.js
msgid "This account cannot sign in."
msgstr "Esta cuenta no puede iniciar sesión."

#. Invite sign-up error, when the consent tick is empty.
#: src/components/InviteSignupForm.jsx
msgid "Tick the box to carry on."
msgstr "Marca la casilla para continuar."

#. Mobile tab bar
#: src/constants/destinations.js
msgid "Today"
msgstr "Hoy"

#. Invite sign-up error.
#. Login error. Only shown in Spanish; English shows the server message.
#: src/components/InviteSignupForm.jsx
#: src/utils/authError.js
msgid "Too many attempts. Wait a few minutes and try again."
msgstr "Demasiados intentos. Espera unos minutos e inténtalo de nuevo."

#. Mobile tab bar
#: src/constants/destinations.js
msgid "Train"
msgstr "Entrenar"

#. Login error for any unrecognised cause. Only shown in Spanish.
#: src/utils/authError.js
msgid "We could not sign you in. Try again."
msgstr "No pudimos iniciar sesión. Inténtalo de nuevo."

#. Login error. Only shown in Spanish; English shows the server message.
#: src/utils/authError.js
msgid "Wrong email or password."
msgstr "Correo o contraseña incorrectos."
