msgstr "¿Tienes un código de invitación?"

#. Invite form field label, all capitals
#: src/components/InviteSignupForm.jsx
msgid "INVITE CODE"
msgstr "CÓDIGO DE INVITACIÓN"

#. Shown while the session or the app is loading
#: src/AuthGate.jsx
msgid "Loading…"
msgstr "Cargando…"

#: src/views/ErgView.jsx
#: src/views/mobile/MobileStrength.jsx
#: src/views/StrengthView.jsx
