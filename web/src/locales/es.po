#. Install-the-app button, all capitals
#: src/AuthGate.jsx
msgid "＋ ADD TO HOME SCREEN"
msgstr "＋ AGREGAR A LA PANTALLA DE INICIO"

#. Link back to the sign-in form from the invite form
#: src/components/InviteSignupForm.jsx
msgid "Back to sign in"
msgstr "Volver a iniciar sesión"

#. Splash word cycle, one discipline, all capitals
#: src/components/SplashScreen.jsx
msgid "BIKE"
msgstr "BICI"

#. Mobile tab bar: readiness, sleep, heart rate
#: src/constants/destinations.js
msgid "Body"
msgstr "Cuerpo"

#. Accessible label on the loading screen. The identifier matches the Obtainium version on Android (for example 1.3.0+1249), a short commit on the web, or dev locally.
#: src/components/SplashScreen.jsx
msgid "Build {APP_BUILD}"
msgstr "Versión {APP_BUILD}"

#. Invite sign-up error, for a malformed email or code.
#: src/components/InviteSignupForm.jsx
msgid "Check the email and the code and try again."
msgstr "Revisa el correo y el código e inténtalo de nuevo."

#. Invite sign-up error. {min} is the minimum length.
#: src/components/InviteSignupForm.jsx
msgid "Choose a longer password: at least {min} characters."
msgstr "Elige una contraseña más larga: mínimo {min} caracteres."

#. Invite form field label, all capitals
#: src/components/InviteSignupForm.jsx
msgid "CHOOSE A PASSWORD"
msgstr "ELIGE UNA CONTRASEÑA"

#. Login error. Only shown in Spanish; English shows the server message.
#: src/utils/authError.js
msgid "Confirm your email address before signing in."
msgstr "Confirma tu correo electrónico antes de iniciar sesión."

#. Invite sign-up error when the device is offline.
#. Login error when the device is offline. Only shown in Spanish.
#: src/components/InviteSignupForm.jsx
#: src/utils/authError.js
msgid "Could not reach the server. Check your connection and try again."
msgstr "No pudimos conectarnos con el servidor. Revisa tu conexión e inténtalo de nuevo."

#. Invite sign-up button
#: src/components/InviteSignupForm.jsx
msgid "CREATE ACCOUNT"
msgstr "CREAR CUENTA"

#. Heading on the invite sign-up form
#: src/components/InviteSignupForm.jsx
msgid "Create your test account"
msgstr "Crea tu cuenta de prueba"

#. Invite sign-up button while the request is in flight
#: src/components/InviteSignupForm.jsx
msgid "CREATING…"
msgstr "CREANDO…"

#. Login form field label, all capitals
#. Login form field label, all capitals
#: src/AuthGate.jsx
#: src/components/InviteSignupForm.jsx
msgid "EMAIL"
msgstr "CORREO ELECTRÓNICO"

#. Login form validation error.
#: src/AuthGate.jsx
msgid "Enter email and password."
msgstr "Ingresa tu correo y tu contraseña."

#: src/views/ErgView.jsx
msgid "Erg"
msgstr "Ergómetro"

#. Splash word cycle, one discipline, all capitals
#: src/components/SplashScreen.jsx
msgid "ERG"
msgstr "ERGÓMETRO"

#. Invite sign-up error.
#: src/components/InviteSignupForm.jsx
msgid "Fill in every field."
msgstr "Completa todos los campos."

#. Link on the testers sign-in form to the invite form
#: src/AuthGate.jsx
